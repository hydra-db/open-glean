# ── Key security ───────────────────────────────────────────
OPEN_GLEAN_SESSION_SECRET=<any random 16+ char string>

# ── Hydra DB ──────────────────────────────────────────────
# Optional deployment-level shared key (bypasses per-user key entry)
HYDRA_API_KEY=<sk_live_… or omit>
HYDRA_BASE_URL=https://api.hydradb.com

# Optional default database/tenant. When set, any request that does not name a
# database is scoped to this one, so "All databases" does not silently miss data
# on shared-key deployments.
HYDRA_DEFAULT_DATABASE=<your default tenant id, e.g. "drive">

# ── LLM provider (answer synthesis + web search) ──────────
OPENROUTER_API_KEY=<sk-or-v1-…>
OPEN_GLEAN_LLM_MODEL=<model id from openrouter.ai/models>

# Latest Gemini: google/gemini-3.7-flash (1M ctx)
# Latest DeepSeek: deepseek/deepseek-v4-flash-0731 (1.3M ctx)

# Optional OpenAI-compatible endpoint for the server-level key (default: OpenRouter)
# OPEN_GLEAN_LLM_BASE_URL=https://openrouter.ai/api/v1
# For Claude through the native Anthropic API, use an Anthropic key above and:
# OPEN_GLEAN_LLM_BASE_URL=https://api.anthropic.com
# OPEN_GLEAN_LLM_MODEL=claude-opus-5-5

# Allow an LLM base URL on a private or loopback address, for a local model
# such as Ollama or LM Studio. Off by default.
# OPEN_GLEAN_ALLOW_PRIVATE_LLM_URL=true

# Concurrent Deep Research runs per instance (default 3). Each run costs many
# LLM and retrieval calls.
# OPEN_GLEAN_MAX_CONCURRENT_RESEARCH=3

# ── Chat persistence ─────────────────────────────────────
#
# Option A: Direct MongoDB (local dev or self-hosted)
#   MONGODB_URI=mongodb://localhost:27017 or mongodb+srv://…
#   MONGODB_DB=open_glean
#
# Option B: Lambda proxy (Vercel to API Gateway to Lambda to DocumentDB)
#   MONGODB_URI=https://<api-id>.execute-api.<region>.amazonaws.com/prod
#   MONGODB_PROXY_KEY=<the shared secret from the Lambda env>
#   MONGODB_DB=open_glean
#
MONGODB_URI=<mongodb://… or https://… proxy endpoint>
MONGODB_PROXY_KEY=<proxy shared secret, only for option B>
MONGODB_DB=open_glean
